# /etc/sudoers.d/tsn5g-ue
#
# Lets the console user drive the 5G UE rig without a password prompt.
#
# Install:
#     sudo install -m0440 -o root -g root \
#         /home/amrc/camera_application/tsn5g-ue-app/docs/tsn5g-ue.sudoers \
#         /etc/sudoers.d/tsn5g-ue
#     sudo visudo -c            # must end with "parsed OK"
#
# Remove:
#     sudo rm /etc/sudoers.d/tsn5g-ue
#
# ---------------------------------------------------------------------------
# There is deliberately no NOPASSWD entry for python3, install, cp, tee, dd,
# sh or bash with open arguments. Any of those is arbitrary code as root, i.e.
# the same authority as `NOPASSWD: ALL` wearing a scoped-looking costume.
#
# The two things that seemed to need it — installing the unit file and running
# the daemon as root — are covered below as fully literal commands instead, so
# the argument vector is fixed and there is nothing to substitute. sudo runs
# with env_reset, so PYTHONPATH and friends cannot be injected either.
# ---------------------------------------------------------------------------

# --- Service control, pinned to this rig's units ---------------------------
Cmnd_Alias TSN5G_SVC = \
    /usr/bin/systemctl start tsn5g-ue, \
    /usr/bin/systemctl stop tsn5g-ue, \
    /usr/bin/systemctl restart tsn5g-ue, \
    /usr/bin/systemctl status tsn5g-ue, \
    /usr/bin/systemctl status tsn5g-ue.service, \
    /usr/bin/systemctl is-active tsn5g-ue, \
    /usr/bin/systemctl is-enabled tsn5g-ue, \
    /usr/bin/systemctl is-enabled ModemManager, \
    /usr/bin/systemctl enable tsn5g-ue, \
    /usr/bin/systemctl disable tsn5g-ue, \
    /usr/bin/systemctl daemon-reload, \
    /usr/bin/systemctl mask ModemManager, \
    /usr/bin/systemctl unmask ModemManager, \
    /usr/bin/systemctl stop ModemManager, \
    /usr/bin/journalctl -u tsn5g-ue, \
    /usr/bin/journalctl -u tsn5g-ue *

# --- Deploying this project's unit file, literally -------------------------
# Source and destination are both fixed. This can overwrite exactly one file
# with exactly one other file, and nothing else.
Cmnd_Alias TSN5G_DEPLOY = \
    /usr/bin/install -m0644 -o root -g root /home/amrc/camera_application/tsn5g-ue-app/systemd/tsn5g-ue.di1200.service /etc/systemd/system/tsn5g-ue.service, \
    /usr/bin/install -m0644 -o root -g root /home/amrc/camera_application/tsn5g-ue-app/systemd/tsn5g-ue.service /etc/systemd/system/tsn5g-ue.service

# --- Running the daemon in the foreground for testing ----------------------
# The module and config path are fixed; only the log-level flag varies. `-m`
# resolves the package from the working directory, and env_reset means
# PYTHONPATH cannot be used to point it somewhere else.
Cmnd_Alias TSN5G_RUN = \
    /usr/bin/python3 -m tsn5g_ue -c /home/amrc/camera_application/tsn5g-ue-app/config/tsn5g-ue.di1200.yaml, \
    /usr/bin/python3 -m tsn5g_ue -c /home/amrc/camera_application/tsn5g-ue-app/config/tsn5g-ue.di1200.yaml -l debug, \
    /usr/bin/python3 -m tsn5g_ue -c /home/amrc/camera_application/tsn5g-ue-app/config/tsn5g-ue.di1200.yaml -l info

# --- The device plane ------------------------------------------------------
# Wide in arguments, bounded in kind: modem control, interface and routing
# configuration, time sync, packet capture. This is the set the daemon itself
# shells out to, so it is what a dedicated service account would need.
#
# Blast radius, stated plainly: `ip` and `iptables` can reroute this machine's
# traffic including the SSH session, and tcpdump reads every packet on the
# wire. That is inherent to the job — and it is why the daemon carries the
# `ip route get` before/after check with automatic rollback.
Cmnd_Alias TSN5G_DEV = \
    /usr/bin/qmicli *, \
    /usr/bin/mbimcli *, \
    /usr/bin/mmcli *, \
    /usr/sbin/ip *, \
    /usr/sbin/iptables *, \
    /usr/sbin/iptables-save, \
    /usr/sbin/tc *, \
    /usr/sbin/ethtool *, \
    /usr/sbin/ptp4l *, \
    /usr/sbin/phc2sys *, \
    /usr/bin/tcpdump *

amrc ALL=(root) NOPASSWD: TSN5G_SVC, TSN5G_DEPLOY, TSN5G_RUN, TSN5G_DEV

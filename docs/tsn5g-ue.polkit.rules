// /etc/polkit-1/rules.d/10-tsn5g-ue.rules
//
// Lets the console user control this project's units from a non-interactive
// shell.
//
// Install:
//     sudo install -m0644 -o root -g root \
//         /home/amrc/camera_application/tsn5g-ue-app/docs/tsn5g-ue.polkit.rules \
//         /etc/polkit-1/rules.d/10-tsn5g-ue.rules
//     (polkitd watches rules.d and reloads on its own; no restart needed)
//
// Remove:
//     sudo rm /etc/polkit-1/rules.d/10-tsn5g-ue.rules
//
// ---------------------------------------------------------------------------
// Why this exists
//
// systemctl does not use sudo. It asks polkit, and on this box:
//
//     org.freedesktop.systemd1.manage-units    implicit active: auth_admin_keep
//     org.freedesktop.systemd1.reload-daemon   implicit active: auth_admin_keep
//
// auth_admin_keep means "prompt an administrator for a password through an
// authentication agent". A non-interactive shell has no agent, so the D-Bus
// call hangs for ~25 s and then reports "Method call timed out". That reads
// like a permission error but is a missing-agent error, which is why it
// intermittently *succeeded* — a desktop agent on the seat0 session sometimes
// fielded the prompt.
//
// Returning YES here answers polkit directly, so no agent is consulted and the
// call returns at once.
//
// ---------------------------------------------------------------------------
// Blast radius, stated plainly
//
// This grants no authority the user does not already have. They are in group
// sudo, which 49-ubuntu-admin.rules already makes a polkit administrator, and
// /etc/sudoers.d/tsn5g-ue already grants passwordless start/stop/restart of
// this unit. All this removes is the prompt, and only for the units named
// below — strictly narrower than the sudoers file already installed.
//
// Deliberately not scoped by verb. systemd's "verb" detail would have to match
// exactly, and a mismatch degrades to the same silent timeout this rule exists
// to remove. The unit is the meaningful boundary anyway: anyone who can
// restart it can already stop it.
// ---------------------------------------------------------------------------

polkit.addRule(function (action, subject) {
    if (subject.user !== "amrc") {
        return polkit.Result.NOT_HANDLED;
    }

    if (action.id === "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        if (unit === "tsn5g-ue.service" || unit === "tsn5g-ue-kiosk.service") {
            return polkit.Result.YES;
        }
    }

    // daemon-reload carries no unit detail; it is global by nature. Needed
    // after the unit file changes, and harmless in itself — it re-reads unit
    // files and starts nothing.
    if (action.id === "org.freedesktop.systemd1.reload-daemon") {
        return polkit.Result.YES;
    }

    // Everything else falls through to its normal default. NOT_HANDLED rather
    // than NO: this rule's job is to permit, never to deny.
    return polkit.Result.NOT_HANDLED;
});

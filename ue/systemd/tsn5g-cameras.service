[Unit]
Description=TSN-5G UE: both camera encoders on screen :99
Documentation=file:///home/amrc/camera_application/tsn5g-ue-app/scripts/cameras-start.sh
# Order matters for each of these: camera 2's NIC is in the namespace, the
# daemon applies the lane rules and camera addresses, and the encoders need a
# screen to open on.
Requires=tsn5g-cam2-netns.service tsn5g-vnc-display.service
After=tsn5g-cam2-netns.service tsn5g-vnc-display.service tsn5g-ue.service
Wants=tsn5g-ue.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=ENC_DISPLAY=:99
# The launcher waits for each camera to answer and to have its control
# channel free, which at boot includes the camera's own start-up.
ExecStart=/home/amrc/camera_application/tsn5g-ue-app/scripts/cameras-start.sh start
ExecStop=/home/amrc/camera_application/tsn5g-ue-app/scripts/cameras-start.sh stop
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target

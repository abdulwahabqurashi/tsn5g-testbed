# Rendered by install.sh -> /etc/sysctl.d/90-tsn5g-ue.conf
# The measurement tools send with iperf3 -w 8M; the kernel's default ceiling
# (212 KB) silently caps that. 16 MB is what the first rig was tested with.
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
# Camera 2's namespace reaches the bearer through the root namespace (veth + NAT).
net.ipv4.ip_forward = 1

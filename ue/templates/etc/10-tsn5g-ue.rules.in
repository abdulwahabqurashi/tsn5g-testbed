// Rendered from ue/templates/etc/10-tsn5g-ue.rules.in by install.sh
//   -> /etc/polkit-1/rules.d/10-tsn5g-ue.rules  (polkitd reloads by itself)
//
// systemctl asks polkit, not sudo. Ubuntu's default for manage-units is
// auth_admin_keep: prompt through an authentication agent. A non-interactive
// shell (the UI's buttons, ssh) has no agent, so the call hangs ~25 s and fails
// with "Method call timed out". Answering YES here, for this project's units
// only, removes the prompt. It grants nothing ${UE_USER} lacks already (sudo
// group, and the sudoers file above allows the same restarts).

polkit.addRule(function (action, subject) {
    if (subject.user !== "${UE_USER}") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id === "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        if (["tsn5g-ue.service", "tsn5g-ue-kiosk.service", "tsn5g-cameras.service",
             "tsn5g-cam2-netns.service", "tsn5g-vnc-display.service"].indexOf(unit) >= 0) {
            return polkit.Result.YES;
        }
    }
    // daemon-reload is global by nature and starts nothing.
    if (action.id === "org.freedesktop.systemd1.reload-daemon") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;   // permit, never deny
});

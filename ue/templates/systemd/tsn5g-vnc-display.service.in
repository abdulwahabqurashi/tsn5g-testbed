# Rendered from ue/templates/systemd/tsn5g-vnc-display.service.in by install.sh
[Unit]
Description=TSN-5G: virtual screen :${DISPLAY_NUM} shared over VNC (localhost:${VNC_PORT})
Documentation=file://${PREFIX}/ue/scripts/vnc-display.sh
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=${UE_USER}
ExecStart=${PREFIX}/ue/scripts/vnc-display.sh up
ExecStop=${PREFIX}/ue/scripts/vnc-display.sh down

[Install]
WantedBy=multi-user.target

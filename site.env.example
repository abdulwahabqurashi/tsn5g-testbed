# =============================================================================
# site.env — every value that differs between one testbed site and another.
#
#   cp site.env.example site.env     then edit; site.env is never committed.
#
# The installers render every config file, systemd unit and script from this
# file, so nothing else in the repository needs editing for a new site. The
# values below are the first rig's (AMRC, 2026) and work as a reference.
# Both machines should use the SAME site.env (the UE needs core addresses and
# the core needs the UE's), so keep one copy and share it.
# =============================================================================

SITE_NAME="amrc-tsn5g"

# --- Install locations ----------------------------------------------------------
PREFIX="/opt/tsn5g"                 # code is installed here (both roles)
ETC_DIR="/etc/tsn5g"                # rendered configs + a copy of site.env
VENDOR_DIR="/srv/tsn5g-vendor"      # where you put the vendor bundles (see video/README.md)

# =============================================================================
# 5G network (must match on core and UE)
# =============================================================================
PLMN_MCC="001"
PLMN_MNC="02"
TAC="1"
DNN="usrptsn"                       # APN / data network name
UE_POOL="10.45.0.0/16"              # UE address pool on the core
CORE_BEARER_IP="10.45.0.1"          # the core's address inside the pool (ogstun) — test target
UE_IP="10.45.0.12"                  # the UE's static address (subscriber record)
PDU_MTU="1400"                      # PDU session MTU signalled to the UE
UE_IMSI="001020000000001"           # SIM keys (K, OPc) go in secrets.env
GBR_SOURCE_PORT="5202"              # uplink matches the GBR flow (QFI 2) by this SOURCE port
GBR_UL_MBPS="25"                    # GBR flow: guaranteed / maximum bit rate
MBR_UL_MBPS="40"
GBR_5QI="4"                         # 5QI of that GBR flow (gNB has RLC AM settings for 4, 7, 9)
DEFAULT_5QI="7"                     # 5QI of the default (best-effort) flow
UE_AMBR_UL_MBPS="50"                # session uplink AMBR

# =============================================================================
# Core server
# =============================================================================
CORE_USER="tsn_server"              # login user that owns the checkout and the viewer
CORE_LAN_IP="10.5.1.19"             # management address (UE and you SSH to this)
CORE_LAN_IF="enp109s0f0np0"         # management NIC — also the NAT uplink for the UE pool
CORE_LAN_GW="10.5.0.2"

# USRP X410 fronthaul
X410_ADDR="192.168.10.2"
X410_HOST_IF="enp109s0f1np1"        # 10G NIC cabled to the X410
X410_HOST_IP="192.168.10.3/24"
X410_MTU="9000"
CORE_PTP_IF=""                      # optional: core NIC with a hardware clock for gPTP (core/ptp/)

# gNB radio
GNB_DL_ARFCN="626666"               # n78 centre 3399.99 MHz
GNB_BAND="78"
GNB_BW_MHZ="100"
GNB_SCS="30"
GNB_SRATE="122.88"                  # Msps; 122.88 for 100 MHz @ 30 kHz (must divide the 245.76 MHz master clock)
GNB_PCI="1"
GNB_TX_GAIN="42"
GNB_RX_GAIN="40"

# gNB real-time CPU layout (see docs/DEPLOY.md, "real-time tuning")
GNB_NUMA_NODE="1"                   # NUMA node of the X410 NIC
GNB_ISOLATED_CPUS="1,5,9,13,17,21,25,29,33,37,41,45,49,53,57,61"  # isolcpus/nohz_full/rcu_nocbs
GNB_RU_CPUS="1,5,9,13"
GNB_MAIN_CPUS="17,21,25,29,33,37,41,45,49,53,57,61"

# Pinned source versions (core/build.sh)
SRSRAN_REPO="https://github.com/srsran/srsRAN_Project.git"
SRSRAN_COMMIT="4bf1543"             # + core/srsran/*.patch
MONGODB_SERIES="7.0"

# =============================================================================
# UE (DI-1200)
# =============================================================================
UE_USER="amrc"                      # desktop user that owns the virtual screen and encoders
UE_LAN_IP="10.5.4.111"
MODEM_WWAN="wwan0"
MODEM_QMI="/dev/cdc-wdm0"
API_PORT="8080"                     # UE web UI / API

# Cameras (FLIR Blackfly S over GigE Vision, link-local)
CAM1_IF="enp8s0"
CAM1_HOST_ADDR="169.254.144.1/24"
CAM1_IP="169.254.144.18"
CAM1_SERIAL="25170575"
CAM1_PORT="50451"                   # protected camera, rides the GBR bearer

CAM2_IF="enp7s0"
CAM2_HOST_ADDR="169.254.143.1/24"
CAM2_IP="169.254.143.18"
CAM2_SERIAL="25170574"
CAM2_PORT="50452"                   # best-effort camera
CAM2_NETNS="cam2"                   # camera 2's encoder runs in its own namespace
CAM2_VETH_NET="10.200.2"            # /30 between root and namespace: .1 root, .2 namespace

# PTP (UE is a slave of the site grandmaster)
PTP_IF="enp3s0"                     # physical NIC with a hardware clock, cabled to the GM switch
PTP_VLAN="4011"                     # leave empty if the switch port is untagged
PTP_DOMAIN="0"
PTP_PROFILE="ieee1588"              # ieee1588 | gptp
UTC_OFFSET="37"                     # TAI - UTC

# =============================================================================
# Video (encoders on the UE, viewer on the core)
# =============================================================================
DISPLAY_NUM="99"                    # virtual screen :99 on both machines
VNC_PORT="5900"                     # x11vnc, localhost only; reach it with ssh -L
SCREEN_GEOMETRY="1920x1080x24"
VIEWER_PORT_FIRST="50451"           # viewer listens on FIRST .. FIRST+6

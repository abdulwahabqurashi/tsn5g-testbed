# Rendered by install.sh core -> ${ETC_DIR}/open5gs/nrf.yaml  (template: core/open5gs/configs/nrf.yaml.in)
logger:
  file:
    path: /var/local/log/open5gs/nrf.log
#  level: info   # fatal|error|warn|info(default)|debug|trace

global:
  max:
    ue: 1024  # The number of UE can be increased depending on memory size.
    peer: 512   # NOT the default 64. pool.subscription = peer*16 (lib/app/ogs-config.c:82),
                # so 64 gives only 1024 slots. This core leaks ~33 subscriptions/day, which
                # exhausts 1024 in 31 days and aborts the NRF on an assert in
                # ogs_sbi_subscription_data_add (lib/sbi/context.c:2721) - it did exactly
                # that on 2026-08-31 after 31 days up. 512 -> 8192 slots (~248 days).
                # Mitigation only; the leak itself is upstream in Open5GS v2.7.6.

nrf:
  serving:  # 5G roaming requires PLMN in NRF
    - plmn_id:
        mcc: ${PLMN_MCC}
        mnc: ${PLMN_MNC}
  sbi:
    server:
      - address: 127.0.0.10
        port: 7777

################################################################################
# SBI Server
################################################################################
#  o Bind to the address on the eth0 and advertise as open5gs-nrf.svc.local
#  sbi:
#    server:
#      - dev:eth0
#        advertise: open5gs-nrf.svc.local
#
#  o Specify a custom port number 7777 while binding to the given address
#  sbi:
#    server:
#      - address: nrf.localdomain
#        port: 7777
#
#  o Bind to 127.0.0.10 and advertise as open5gs-nrf.svc.local

[Unit]
Description=DS-TT Device-Side TSN Translator
Documentation=https://github.com/open5gs/open5gs
After=network.target ModemManager.service
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m ds_tt -c /etc/ds-tt/ds-tt.yaml
Restart=on-failure
RestartSec=5

# Run as root (required for bridge creation and modem access)
User=root

# Working directory
WorkingDirectory=/opt/ds-tt

# Environment
Environment=PYTHONPATH=/opt/ds-tt

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ds-tt

# Security hardening
ProtectSystem=strict
ReadWritePaths=/sys/class/net /sys/devices /dev
PrivateTmp=true
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target

logger:
  file:
    path: @localstatedir@/log/open5gs/upf.log
#  level: info   # fatal|error|warn|info(default)|debug|trace

global:
  max:
    ue: 1024  # The number of UE can be increased depending on memory size.
#    peer: 64

upf:
  pfcp:
    server:
      - address: 127.0.0.7
    client:
#      smf:     #  UPF PFCP Client try to associate SMF PFCP Server
#        - address: 127.0.0.4
  gtpu:
    server:
      - address: 127.0.0.7   # N3 GTP-U; srsRAN gNB is co-located (loopback). Was 10.11.8.101 (separate-gNB placeholder).
  session:
    - subnet: 10.45.0.0/16
      gateway: 10.45.0.1
    - subnet: 2001:db8:cafe::/48
      gateway: 2001:db8:cafe::1
    - dnn: TSN
      dev: ogstap
  nwtt:
    enabled: true
    dl_mac_adaptation: true    # routed-mode UE: readdress DL unicast to gateway MAC
    bridge_id: 1
    bridge_mac: "02:00:00:00:00:01"
    qos_mappings:
      - pcp: 7
        qfi: 86
      - pcp: 6
        qfi: 85
      - pcp: 5
        qfi: 84
    timestamp:
      clock_source: monotonic
    gptp:
      enabled: true
      time_domain_number: 0
      degrade_on_unsync: false
  metrics:
    server:
      - address: 127.0.0.7
        port: 9090

################################################################################
# PFCP Server
################################################################################
# o Override PFCP address to be advertised to SMF in PFCP association
#  pfcp:
#    server:
#      - dev: eth0
#        advertise: open5gs-upf.svc.local
#
################################################################################
# GTP-U Server
################################################################################

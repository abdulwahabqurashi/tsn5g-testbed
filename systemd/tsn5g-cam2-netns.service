[Unit]
Description=TSN-5G UE: camera 2's network namespace (enp7s0 -> netns cam2)
Documentation=file:///home/amrc/camera_application/tsn5g-ue-app/scripts/camera2-netns.sh
# The namespace must exist before the daemon starts: the daemon addresses and
# health-checks camera 2 inside it, and finding the NIC in the root namespace
# instead would put both cameras in front of one encoder again.
Before=tsn5g-ue.service
After=NetworkManager.service systemd-udev-settle.service
# Deliberately no dependency on the enp7s0 device unit. Moving the NIC into the
# namespace removes it from the root namespace, so its device unit goes away:
# BindsTo= then stopped this unit (and ran `down`) the moment `up` succeeded,
# and refused to start at all while the NIC was already moved. The script
# waits for the NIC itself instead.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/home/amrc/camera_application/tsn5g-ue-app/scripts/camera2-netns.sh ensure
ExecStop=/home/amrc/camera_application/tsn5g-ue-app/scripts/camera2-netns.sh down

[Install]
WantedBy=multi-user.target

[Unit]
Description=TSN-5G UE Console (device-side TSN translator + control API)
Documentation=https://github.com/AMRC/tsn5g-ue-app
After=network.target
Wants=network.target
# NOTE: deliberately NOT ordered after ModemManager.service. ModemManager is
# masked by policy on a UE — it fights the daemon for /dev/ttyUSB* and rewrites
# radio preferences. Ordering after a masked unit is a no-op at best.
# See docs/reference/connect.sh for why `stop` alone is not enough (D-Bus
# reactivates it; only `mask` holds it down).

[Service]
Type=simple
# Runs as root: creates bridges/VXLAN/VLAN interfaces, drives the modem
# (AT over /dev/ttyUSB*, qmicli over /dev/cdc-wdm0), and runs ptp4l.
User=root
ExecStart=/usr/bin/python3 -m tsn5g_ue -c /etc/tsn5g-ue/tsn5g-ue.yaml
WorkingDirectory=/opt/tsn5g-ue
Environment=PYTHONPATH=/opt/tsn5g-ue
Restart=on-failure
RestartSec=3
# A visible, non-fatal warning rather than a hard dependency.
ExecStartPre=-/bin/sh -c 'systemctl is-enabled ModemManager 2>/dev/null | grep -qx masked || logger -t tsn5g-ue "WARNING: ModemManager is not masked; it will contend for the modem"'
# /var/lib/tsn5g-ue — persistent state (auto-resume, settings overlay, sqlite).
StateDirectory=tsn5g-ue
# /run/tsn5g-ue — bearer PDH/CID and applied routing rules. Must NOT survive a
# reboot: neither does the data call they describe.
RuntimeDirectory=tsn5g-ue
# Without this systemd deletes /run/tsn5g-ue on every stop, taking the
# bearer's packet data handle with it — and a data call whose handle is
# gone can only be abandoned, not stopped. The directory holds runtime
# state that must outlive the daemon but not a reboot, which is exactly
# what RuntimeDirectoryPreserve=yes means.
RuntimeDirectoryPreserve=yes
# A wedged SSE stream or in-flight job must not block a restart indefinitely.
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target

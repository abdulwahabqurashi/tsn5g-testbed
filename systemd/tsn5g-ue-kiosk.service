[Unit]
Description=TSN-5G UE Console kiosk (full-screen browser on the local UI)
# The backend must be serving before we point a browser at it.
After=tsn5g-ue.service graphical.target
Wants=tsn5g-ue.service
Requires=graphical.target

[Service]
Type=simple
# Runs in the graphical session of the console user.
# Override User=/Environment=DISPLAY to match the UE's console user during imaging.
User=kiosk
Environment=DISPLAY=:0
ExecStartPre=/bin/sh -c 'until curl -sf http://localhost:8080/ >/dev/null; do sleep 1; done'
ExecStart=/opt/tsn5g-ue/desktop/kiosk.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target

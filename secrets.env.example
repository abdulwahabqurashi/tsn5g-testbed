# =============================================================================
# secrets.env — subscriber keys and passwords. NEVER commit this file.
#
#   cp secrets.env.example secrets.env && chmod 600 secrets.env
#
# Used only on the core (core/open5gs/provision.sh writes the subscriber into
# MongoDB). The values are on the SIM card's data sheet / programming record.
# =============================================================================

UE_K=""              # 32 hex characters
UE_OPC=""            # 32 hex characters
UE_AMF="8000"
UE_IMEISV=""         # optional

WEBUI_ADMIN_PASSWORD=""   # Open5GS WebUI admin account
